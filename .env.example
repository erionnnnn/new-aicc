# 복사해서 .env 로 쓰지 말고 환경변수 또는 .aicc/secrets.env 로 설정하십시오.
# 개발 모드에서는 .aicc/secrets.env 가 자동 생성됩니다. 운영(AICC_ENV=production)은 반드시 직접 지정.
AICC_ENV=development
AICC_DATA_DIR=.aicc
# AICC_DATABASE_URL=postgresql+psycopg://aicc:비밀번호@127.0.0.1:5432/aicc
# AICC_DATA_KEY=<Fernet 키: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())">
# AICC_HMAC_KEY=<임의의 긴 문자열>
AICC_HOST=127.0.0.1
AICC_PORT=8765

# ---- PC 에이전트(실기기) — .aicc/agent.env 에 둡니다 ----
# AICC_DEVICE_TOKEN=<웹 설정 > 단말 등록에서 발급>
# AICC_DEVICE_KIND=a24
# AICC_ADB=C:\platform-tools\adb.exe
# AICC_ADB_SERIAL=
# AICC_RX_DEVICE=<통화 수신 음성이 들어오는 입력 장치 번호/이름 — 실기기 검증 전 미확정>
# AICC_TX_DEVICE=<통화 송신으로 나가는 출력 장치 — PC 기본 스피커 금지>
# AICC_STT_ENGINE=faster-whisper
# AICC_WHISPER_MODEL=small
# AICC_AI=gemini-live
# GEMINI_API_KEY=
# AICC_GEMINI_MODEL=<공식 문서에서 확인한 Live API 모델명>
